<?php

declare(strict_types=1);

// Copy to config/local.php and adjust. php-fpm runs chrooted on OpenBSD while bin/planner
// runs outside it, so the data directory is given relative to the checkout: this resolves
// to /var/www/planner-data on the host and /planner-data inside the chroot.
return [
    'base_url' => 'https://planner.codevoid.de',
    'data_dir' => dirname(__DIR__, 2) . '/planner-data',
    'mail' => [
        'transport' => 'smtp',
        'from' => 'planner@codevoid.de',
    ],
];
