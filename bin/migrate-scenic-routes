#!/usr/bin/env php
<?php

declare(strict_types=1);

use Planner\Kernel;
use Planner\Trip\InvalidDocument;
use Planner\Trip\TripDocuments;

require dirname(__DIR__) . '/vendor/autoload.php';

// Run once to tidy the routes Scenic exported three ways, then delete this file.
// It only says what it would do unless it is given --apply.
const TRIP_EXTENSION = ' (Garmin Trip Extension)';
const ROUTE_POINT_EXTENSION = ' (Garmin RoutePoint Extension)';
const PLAIN = ' (plain GPX)';

/**
 * The day without its routes named after the trip extension, and without those named
 * after the route point extension whose day has exactly one route of their name as plain
 * GPX. A stop at a point of a removed route goes to the plain route's point at the same
 * place, or stands free where there is none. Null for a day that stays as it is.
 */
function swept(array $day, string $where, array &$tally): ?array
{
    $key = fn (array $lngLat): string => json_encode([(float) $lngLat[0], (float) $lngLat[1]]);
    $plain = [];
    foreach ($day['routes'] as $route) {
        if (str_ends_with($route['name'], PLAIN)) {
            $plain[substr($route['name'], 0, -strlen(PLAIN))][] = $route;
        }
    }
    $kept = [];
    // The points of the removed routes, by id: the plain route's point at the same place, or null.
    $rebound = [];
    foreach ($day['routes'] as $route) {
        $ofTrip = str_ends_with($route['name'], TRIP_EXTENSION);
        $ofPoints = str_ends_with($route['name'], ROUTE_POINT_EXTENSION);
        $twins = $plain[substr($route['name'], 0, -strlen($ofTrip ? TRIP_EXTENSION : ROUTE_POINT_EXTENSION))] ?? [];
        if (!$ofTrip && !($ofPoints && count($twins) === 1)) {
            if ($ofPoints) {
                $tally['left'][] = "$where: {$route['name']}";
            }
            $kept[] = ['id' => $route['id'], 'unchanged' => true];
            continue;
        }
        $tally[$ofTrip ? 'trip' : 'points']++;
        $at = [];
        foreach (count($twins) === 1 ? $twins[0]['points'] ?? [] : [] as $point) {
            $at[$key($point['lngLat'])] ??= $point['id'];
        }
        foreach ($route['points'] ?? [] as $point) {
            $rebound[$point['id']] = $at[$key($point['lngLat'])] ?? null;
        }
    }
    if (count($kept) === count($day['routes'])) {
        return null;
    }
    foreach ($day['stops'] as $i => $stop) {
        if ($stop['pointId'] !== null && array_key_exists($stop['pointId'], $rebound)) {
            $day['stops'][$i]['pointId'] = $rebound[$stop['pointId']];
            $tally[$rebound[$stop['pointId']] === null ? 'freed' : 'moved']++;
        }
    }
    return ['routes' => $kept] + $day;
}

$apply = in_array('--apply', $argv, true);
$container = Kernel::container(dirname(__DIR__));
$documents = $container->get(TripDocuments::class);
$tally = ['trip' => 0, 'points' => 0, 'moved' => 0, 'freed' => 0, 'left' => []];
$trips = 0;

foreach ($container->get(PDO::class)->query('SELECT id, user_id FROM trips ORDER BY id')->fetchAll() as $trip) {
    $document = $documents->load((int) $trip['user_id'], (int) $trip['id']);
    $changed = false;
    foreach ($document['days'] as $i => $day) {
        $swept = swept($day, "{$document['name']} › " . ($day['name'] !== '' ? $day['name'] : 'day ' . ($i + 1)), $tally);
        $changed = $changed || $swept !== null;
        $document['days'][$i] = $swept ?? ['id' => $day['id'], 'unchanged' => true];
    }
    if (!$changed) {
        continue;
    }
    $trips++;
    if ($apply) {
        try {
            $documents->save((int) $trip['user_id'], (int) $trip['id'], $document, $document['version'], new DateTimeImmutable());
        } catch (InvalidDocument $refused) {
            fwrite(STDERR, "The trip {$trip['id']} “{$document['name']}” stays as it is: {$refused->getMessage()}\n");
        }
    }
}

echo ($apply ? 'Removed' : 'Would remove') . " {$tally['trip']} routes named “" . trim(TRIP_EXTENSION) . "” and {$tally['points']} named “" . trim(ROUTE_POINT_EXTENSION) . "”, in $trips trips.\n";
echo "{$tally['moved']} waypoints " . ($apply ? 'went' : 'go') . ' to the route named “' . trim(PLAIN) . "”; {$tally['freed']} stand free, where it has no point at their place.\n";
if ($tally['left'] !== []) {
    echo count($tally['left']) . ' routes named “' . trim(ROUTE_POINT_EXTENSION) . "” stay, since their day has not exactly one route of their name as plain GPX:\n  " . implode("\n  ", $tally['left']) . "\n";
}
if (!$apply) {
    echo "Nothing was changed. Run again with --apply to do it.\n";
}
