#!/usr/bin/env php
<?php

declare(strict_types=1);

use Planner\Kernel;
use Planner\Poi\Kinds;

require dirname(__DIR__) . '/vendor/autoload.php';

// Run once, after `make init`, on a database that kept its fetches per area, then delete this file.
$container = Kernel::container(dirname(__DIR__));
$db = $container->get(PDO::class);
$note = $db->prepare(
    'INSERT OR IGNORE INTO place_fetches (area, kind, places, fetched_at)
     SELECT a.area, :kind, (SELECT COUNT(*) FROM places p WHERE p.area = a.area AND p.kind = :kind), a.fetched_at FROM place_areas a',
);
foreach ($container->get(Kinds::class)->ids() as $kind) {
    $note->execute(['kind' => $kind]);
}
$db->exec('DROP TABLE place_areas');
echo "The fetches are kept per kind.\n";
