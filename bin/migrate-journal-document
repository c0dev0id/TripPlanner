#!/usr/bin/env php
<?php

declare(strict_types=1);

use Planner\Config;
use Planner\Database;
use Planner\Journal\Exif;
use Planner\Journal\FileStore;
use Planner\Kernel;

require dirname(__DIR__) . '/vendor/autoload.php';

// Run once after the journal became a document with an order of its own and a
// publication apart from the share link, then delete this file. It adds the columns of
// both, keeps the entries in the order they were added, publishes the journal of every
// trip that is shared, reads every image again for its size and for where it was taken,
// and gives the previews the name of the smallest of the sizes an image is now kept at.
// Running it twice does no harm.
$container = Kernel::container(dirname(__DIR__));
$db = $container->get(PDO::class);
$files = $container->get(FileStore::class);

$has = fn (string $table, string $column) => in_array($column, array_column($db->query("PRAGMA table_info($table)")->fetchAll(), 'name'), true);
$db->beginTransaction();
if (!$has('entries', 'position')) {
    $db->exec('ALTER TABLE entries ADD COLUMN position INTEGER NOT NULL DEFAULT 0');
    $db->exec('ALTER TABLE entries ADD COLUMN width INTEGER');
    $db->exec('ALTER TABLE entries ADD COLUMN height INTEGER');
    $db->exec('ALTER TABLE entries ADD COLUMN taken_lng REAL');
    $db->exec('ALTER TABLE entries ADD COLUMN taken_lat REAL');
    $db->exec('UPDATE entries SET position = id');
}
if (!$has('trips', 'journal_published')) {
    $db->exec('ALTER TABLE trips ADD COLUMN journal_published INTEGER NOT NULL DEFAULT 0');
    $db->exec('ALTER TABLE trips ADD COLUMN gpx_public INTEGER NOT NULL DEFAULT 1');
    $db->exec('ALTER TABLE trips ADD COLUMN cover_entry_id INTEGER REFERENCES entries(id) ON DELETE SET NULL');
    $db->exec('UPDATE trips SET journal_published = 1 WHERE share_token IS NOT NULL');
}
$images = $db->prepare('SELECT id, trip_id, media_type FROM entries WHERE width IS NULL AND media_type IN (' . Database::placeholders(FileStore::PREVIEWABLE) . ')');
$images->execute(FileStore::PREVIEWABLE);
$measure = $db->prepare('UPDATE entries SET width = ?, height = ?, taken_lng = ?, taken_lat = ? WHERE id = ?');
$read = 0;
foreach ($images->fetchAll() as $image) {
    $path = $files->path((int) $image['trip_id'], (int) $image['id']);
    $pixels = FileStore::pixelsOf($path, $image['media_type']);
    if ($pixels === null) {
        continue;
    }
    $taken = Exif::read($path, $image['media_type'])['lngLat'];
    $measure->execute([$pixels[0], $pixels[1], $taken[0] ?? null, $taken[1] ?? null, $image['id']]);
    $read++;
}
$db->commit();
$renamed = 0;
foreach (glob($container->get(Config::class)->dataDir . '/files/*/*.preview.jpg') as $preview) {
    $renamed += (int) rename($preview, substr($preview, 0, -strlen('preview.jpg')) . FileStore::SIZES[0] . '.jpg');
}
echo "The journal has its columns; read $read images for their size and place and renamed $renamed previews.\n";
