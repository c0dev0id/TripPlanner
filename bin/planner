#!/usr/bin/env php
<?php

declare(strict_types=1);

use Planner\Account\Users;
use Planner\Closures\MotorcycleClosures;
use Planner\Database;
use Planner\Journal\FileStore;
use Planner\Kernel;
use Planner\Poi\Areas;
use Planner\Poi\Kinds;
use Planner\Poi\PlaceFetch;
use Planner\Poi\Places;
use Planner\Signup\Inviter;
use Planner\Symbols\GarminPictures;

require dirname(__DIR__) . '/vendor/autoload.php';

$root = dirname(__DIR__);
$container = Kernel::container($root);
$command = $argv[1] ?? '';
$argument = $argv[2] ?? null;

switch ($command) {
    case 'db:init':
        Database::applySchema($container->get(PDO::class), $root . '/db/schema.sql');
        echo "Schema applied.\n";
        break;
    case 'db:recreate':
        Database::dropAll($container->get(PDO::class));
        Database::applySchema($container->get(PDO::class), $root . '/db/schema.sql');
        $container->get(FileStore::class)->clear();
        echo "Database recreated; every account, trip and file is gone.\n";
        break;
    case 'invite':
        $container->get(Inviter::class)->invite(require_argument($argument), null, new DateTimeImmutable());
        echo "Invitation sent to $argument.\n";
        break;
    case 'user:create':
        $email = require_argument($argument);
        $users = $container->get(Users::class);
        if (filter_var($email, FILTER_VALIDATE_EMAIL) === false) {
            fwrite(STDERR, "$email is no e-mail address.\n");
            exit(1);
        }
        if ($users->findByEmail($email) !== null) {
            fwrite(STDERR, "There is an account for $email already.\n");
            exit(1);
        }
        $password = $users->createWithInitialPassword($email, new DateTimeImmutable());
        echo "Account made for $email with the password $password, to be replaced at the first sign-in.\n";
        break;
    case 'user:password':
        $email = require_argument($argument);
        $password = $argv[3] ?? '';
        if ($password === '') {
            fwrite(STDERR, "A password is needed.\n");
            exit(1);
        }
        $users = $container->get(Users::class);
        $user = $users->findByEmail($email);
        if ($user === null) {
            fwrite(STDERR, "No account for $email.\n");
            exit(1);
        }
        $users->changePassword($user->id, $password);
        echo "Password set for $email.\n";
        break;
    case 'admin:grant':
        $granted = $container->get(Users::class)->grantAdmin(require_argument($argument));
        echo $granted ? "$argument is an admin now.\n" : "No account for $argument.\n";
        exit($granted ? 0 : 1);
    case 'garmin:icons':
        $result = GarminPictures::fetch($root . '/frontend/symbols/garmin-symbols.json', $root . '/public/garmin-symbols');
        echo "Garmin symbol pictures: {$result['fetched']} fetched, {$result['kept']} already there.\n";
        if ($result['missing'] !== []) {
            echo 'No picture at the source for ' . implode('; ', $result['missing']) . "; the list's withoutPicture should name them.\n";
        }
        break;
    case 'closures:fetch':
        try {
            $features = MotorcycleClosures::fetch($root . '/public/closures.geojson');
        } catch (RuntimeException $failure) {
            fwrite(STDERR, $failure->getMessage() . "\n");
            exit(1);
        }
        echo "Motorcycle closures: $features places and stretches.\n";
        break;
    case 'places:fetch':
        if ($argument === null || $argument === '') {
            echo "The areas to fetch places of, one at a time: make places AREA=<code>\n\n", Areas::listing($container->get(Places::class)->fetches(), $container->get(Kinds::class)->ids());
            break;
        }
        try {
            $fetched = $container->get(PlaceFetch::class)->fetch((string) $argument, new DateTimeImmutable());
        } catch (RuntimeException | InvalidArgumentException $failure) {
            fwrite(STDERR, $failure->getMessage() . "\n");
            exit(1);
        }
        echo "Places of $argument: {$fetched['places']} fetched.\n";
        if ($fetched['missed'] !== []) {
            fwrite(STDERR, "Not answered for $argument and left as they were: " . implode(', ', $fetched['missed']) . ". Fetch the area again.\n");
            exit(1);
        }
        break;
    default:
        fwrite(STDERR, "Usage: bin/planner db:init | db:recreate | invite <email> | user:create <email> | user:password <email> <password> | admin:grant <email> | garmin:icons | closures:fetch | places:fetch [<area>]\n");
        exit(1);
}

function require_argument(?string $argument): string
{
    if ($argument === null || $argument === '') {
        fwrite(STDERR, "An e-mail address is needed.\n");
        exit(1);
    }
    return $argument;
}
