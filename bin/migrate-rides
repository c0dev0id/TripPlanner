#!/usr/bin/env php
<?php

declare(strict_types=1);

use Planner\Database;
use Planner\Kernel;

require dirname(__DIR__) . '/vendor/autoload.php';

// Run once on a database made before a ride was kept for itself and put on days, then delete this file.
$root = dirname(__DIR__);
$db = Kernel::container($root)->get(PDO::class);
$count = fn (string $sql): int => (int) $db->query($sql)->fetchColumn();

// Foreign keys are off while the tables are rebuilt, and a renamed table keeps what refers to it by its old name.
$db->exec('PRAGMA foreign_keys = OFF');
$db->exec('PRAGMA legacy_alter_table = ON');
$db->beginTransaction();

$digest = $db->prepare('UPDATE recordings SET digest = ? WHERE id = ?');
foreach ($db->query("SELECT id, gpx FROM recordings WHERE digest = ''")->fetchAll() as $row) {
    $digest->execute([hash('sha256', (string) gzdecode($row['gpx'])), $row['id']]);
}

$db->exec('ALTER TABLE folders RENAME TO folders_before');
$db->exec('ALTER TABLE recordings RENAME TO recordings_before');
foreach (['folders_user', 'folders_parent', 'folders_special', 'recordings_day', 'recordings_digest'] as $index) {
    $db->exec("DROP INDEX IF EXISTS $index");
}
$db->exec('DROP TRIGGER users_special_folders');
Database::applySchema($db, $root . '/db/schema.sql');

// The folder for recordings and the folders in it, and the collections in them that hold nothing but recordings.
$db->exec(
    "CREATE TEMP TABLE waiting AS WITH RECURSIVE inside(id) AS (SELECT id FROM folders_before WHERE kind = 'recordings' UNION ALL SELECT f.id FROM folders_before f JOIN inside ON f.parent_id = inside.id)
     SELECT id FROM inside",
);
$db->exec(
    'CREATE TEMP TABLE emptied AS SELECT t.id FROM trips t WHERE t.folder_id IN (SELECT id FROM waiting)
       AND NOT EXISTS (SELECT 1 FROM entries WHERE trip_id = t.id)
       AND NOT EXISTS (SELECT 1 FROM days d WHERE d.trip_id = t.id AND (EXISTS (SELECT 1 FROM routes WHERE day_id = d.id) OR EXISTS (SELECT 1 FROM stops WHERE day_id = d.id)))',
);

// Each file once for its user, as the earliest recording of it; on the days its recordings were on, but for those that waited for theirs.
$db->exec(
    'CREATE TEMP TABLE kept AS SELECT b.id AS before_id, b.day_id, d.trip_id, t.user_id,
            (SELECT MIN(o.id) FROM recordings_before o JOIN days od ON od.id = o.day_id JOIN trips ot ON ot.id = od.trip_id WHERE ot.user_id = t.user_id AND o.digest = b.digest) AS id
     FROM recordings_before b JOIN days d ON d.id = b.day_id JOIN trips t ON t.id = d.trip_id',
);
$db->exec(
    'INSERT INTO recordings (id, user_id, name, created_at, line, distance_m, started_at, digest, gpx)
     SELECT b.id, k.user_id, b.name, b.created_at, b.line, b.distance_m, b.started_at, b.digest, b.gpx FROM recordings_before b JOIN kept k ON k.before_id = b.id WHERE k.id = b.id',
);
$db->exec('INSERT OR IGNORE INTO recording_days (day_id, recording_id) SELECT day_id, id FROM kept WHERE trip_id NOT IN (SELECT id FROM emptied)');

$db->exec('DELETE FROM days WHERE trip_id IN (SELECT id FROM emptied)');
$db->exec('DELETE FROM trips WHERE id IN (SELECT id FROM emptied)');

// What else was in the folder for recordings goes to the one for collections; a folder left empty goes.
$db->exec("INSERT INTO folders (id, user_id, parent_id, name, kind, created_at) SELECT id, user_id, parent_id, name, kind, created_at FROM folders_before WHERE kind <> 'recordings'");
$collections = "(SELECT c.id FROM folders c WHERE c.user_id = %s.user_id AND c.kind = 'collections')";
$db->exec("UPDATE folders SET parent_id = " . sprintf($collections, 'folders') . " WHERE parent_id IN (SELECT id FROM folders_before WHERE kind = 'recordings')");
$moved = $count('SELECT COUNT(*) FROM trips WHERE folder_id IN (SELECT id FROM waiting)');
$db->exec("UPDATE trips SET folder_id = " . sprintf($collections, 'trips') . " WHERE folder_id IN (SELECT id FROM folders_before WHERE kind = 'recordings')");
do {
    $gone = $db->exec(
        'DELETE FROM folders WHERE id IN (SELECT id FROM waiting) AND NOT EXISTS (SELECT 1 FROM trips WHERE folder_id = folders.id) AND NOT EXISTS (SELECT 1 FROM folders f WHERE f.parent_id = folders.id)',
    );
} while ($gone > 0);

$files = $count('SELECT COUNT(*) FROM recordings_before');
$emptied = $count('SELECT COUNT(*) FROM emptied');
$db->exec('DROP TABLE recordings_before');
$db->exec('DROP TABLE folders_before');
$broken = $db->query('PRAGMA foreign_key_check')->fetchAll();
if ($broken !== []) {
    $db->rollBack();
    fwrite(STDERR, 'Nothing was changed: ' . count($broken) . " rows would refer to rows that are gone.\n");
    exit(1);
}
$db->commit();
$db->exec('PRAGMA legacy_alter_table = OFF');
$db->exec('PRAGMA foreign_keys = ON');

$rides = $count('SELECT COUNT(*) FROM recordings');
$links = $count('SELECT COUNT(*) FROM recording_days');
echo "$rides rides are kept, of $files recordings; $links times a ride is on a day.\n";
echo "$emptied collections of recordings that waited for their day are gone, $moved others are in the folder for collections.\n";
