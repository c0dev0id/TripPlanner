#!/usr/bin/env php
<?php

declare(strict_types=1);

use Planner\Kernel;

require dirname(__DIR__) . '/vendor/autoload.php';

// Run once on a database made before routes had a colour, then delete this file.
Kernel::container(dirname(__DIR__))->get(PDO::class)->exec('ALTER TABLE routes ADD COLUMN color TEXT');
echo "The routes table has its colour column.\n";
