#!/usr/bin/env php
<?php

declare(strict_types=1);

use Planner\Kernel;
use Planner\Trip\Outline;
use Planner\Trip\TripDocuments;

require dirname(__DIR__) . '/vendor/autoload.php';

// Run once on a database whose outlines were made before they kept each route's length, then delete this file.
$container = Kernel::container(dirname(__DIR__));
$db = $container->get(PDO::class);
$documents = $container->get(TripDocuments::class);
$keep = $db->prepare('UPDATE days SET outline = ? WHERE id = ?');
$trips = $db->query('SELECT id, user_id, name FROM trips ORDER BY id')->fetchAll();
foreach ($trips as $trip) {
    $document = $documents->load((int) $trip['user_id'], (int) $trip['id']);
    foreach ($document['days'] as $day) {
        $keep->execute([Outline::stored($day, null), $day['id']]);
    }
    echo "$trip[name]: " . count($document['days']) . " days\n";
}
echo 'The days of ' . count($trips) . " trips have their outlines with lengths.\n";
