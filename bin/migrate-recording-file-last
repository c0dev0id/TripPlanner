#!/usr/bin/env php
<?php

declare(strict_types=1);

use Planner\Database;
use Planner\Kernel;

require dirname(__DIR__) . '/vendor/autoload.php';

// Run once on a database whose recordings keep their file before what is read from it, then delete this file.
$root = dirname(__DIR__);
$db = Kernel::container($root)->get(PDO::class);
$db->beginTransaction();
$db->exec('ALTER TABLE recordings RENAME TO recordings_before');
$db->exec('DROP INDEX recordings_day');
$db->exec('DROP INDEX recordings_digest');
Database::applySchema($db, $root . '/db/schema.sql');
$moved = $db->exec(
    'INSERT INTO recordings (id, day_id, name, created_at, line, distance_m, started_at, digest, gpx)
     SELECT id, day_id, name, created_at, line, distance_m, started_at, digest, gpx FROM recordings_before',
);
$db->exec('DROP TABLE recordings_before');
$db->commit();
// Gives the room of the table left behind back to the disk.
$db->exec('VACUUM');
echo "$moved recordings keep their file behind what is read from it.\n";
