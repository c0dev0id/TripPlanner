# OpenBSD httpd server block for the planner, behind TLS termination. Paths are inside
# httpd's chroot (/var/www): the checkout is /var/www/planner.
#
# httpd uses the first matching location, so the static files come before the catch-all
# that hands every other path to the front controller. With SCRIPT_FILENAME fixed there
# is no rewrite, and REQUEST_URI reaches PHP unchanged, which the router relies on.

server "planner.codevoid.de" {
	listen on 127.0.0.1 port 80
	listen on ::1 port 80
	root "/planner/public"

	location "/.well-known/acme-challenge/*" {
		root "/acme"
		request strip 2
		directory auto index
	}

	# Static files: the built frontend, Garmin's symbol pictures (make garmin-icons) and the
	# stylesheet of the public pages.
	location "/build/*" {
		root "/planner/public"
	}
	location "/garmin-symbols/*" {
		root "/planner/public"
	}
	location "/site.css" {
		root "/planner/public"
	}

	# Everything else is the PHP application.
	location "/*" {
		fastcgi socket "/run/php-fpm.sock"
		fastcgi param SCRIPT_FILENAME "/planner/public/index.php"
	}
}
